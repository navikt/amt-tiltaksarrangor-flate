{
  "name": "amt-tiltaksarrangor-flate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "build:gh-pages": "NODE_ENV=development vite build --mode demo --base=/amt-tiltaksarrangor-flate/ && cpy index.html build --cwd=build --rename=404.html",
    "test": "vitest",
    "lint": "eslint --max-warnings=0 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint --fix 'src/**/*.{ts,tsx,js}'",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "playwright": "playwright test",
    "playwright:debug": "playwright test --debug",
    "playwright:open": "playwright test --ui"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write src/**/*"
    ]
  },
  "dependencies": {
    "@navikt/aksel-icons": "^8.19.0",
    "@navikt/ds-css": "^8.19.0",
    "@navikt/ds-react": "^8.19.0",
    "@navikt/nav-dekoratoren-moduler": "^4.5.1",
    "@sentry/react": "^11.6.0",
    "axios": "^1.20.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@navikt/aksel": "^8.19.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "msw": "^3.0.2",
    "prettier": "^3.9.9",
    "sass": "^1.105.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "packageManager": "pnpm@11.8.0"
}